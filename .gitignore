# generated by tools/extract.py — never committed, always rebuilt from the jar
assets/

# generated headers (data tables / atlas coordinates), rebuilt from assets
port/source/*_gen.h

# local emulator driver (machine-specific paths, not part of the port)
/tools/emu.py

# retail ROMs / devkit output
build/
*.3dsx
*.elf
*.cia
*.o
*.a

__pycache__/
*.pyc
.pytest_cache/

# editor noise
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store
*.log

# scratch: downloads, probe scripts, pacman logs
.tmp/
